# check-plugin-updates.conf
# Copy this file to check-plugin-updates.conf alongside the script and fill in
# your values. The .conf file is gitignored — do not commit it.

# Required: absolute path to your local UserSpice project root
PROJECT_ROOT="/path/to/your/userspice/site"

# Required: your GitHub repository in owner/repo format
GH_REPO="your-org/your-repo"

# Optional: space-separated list of environment names for the update checklist.
# Each entry becomes one checklist item in the GitHub issue body.
ENVIRONMENTS="Local/dev staging.yoursite.com yoursite.com"

# Optional overrides (defaults shown — only set if you need to change them)
# UPSTREAM_REPO="mudmin/usplugins"   # upstream UserSpice plugin monorepo
# PLUGINS_PATH="usersc/plugins"      # plugins dir relative to REPO_ROOT
# ISSUE_LABEL="plugin-update"        # GitHub label applied to opened issues
