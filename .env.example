# Elan Registry — required environment variables
# Copy to .env, fill in production credentials, then: chmod 600 .env
# NEVER commit .env to git

DB_HOST=hostname
DB_USER=database_user
DB_PASS=database_password
DB_NAME=database_name

# TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Admin notification / feedback-form recipient addresses (see #1067).
# Falls back to registrar@elanregistry.org if unset.
# ADMIN_EMAILS=registrar@elanregistry.org
# FEEDBACK_EMAIL=registrar@elanregistry.org
