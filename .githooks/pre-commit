#!/bin/bash

#
# Pre-commit hook to enforce coding standards
#
# This hook runs before each commit and prevents commits that violate
# the Elan Registry coding standards. It only checks staged files.
#
# To install: git config core.hooksPath .githooks
# To bypass: git commit --no-verify (use sparingly!)
#
# Checks performed:
#   1. PHP Coding Standards (security, types, documentation, and — for
#      tests/unit/regression/*.php — issue-linking traceability; see
#      checkRegressionTestStructure() in scripts/check-coding-standards.php,
#      the single source of truth for that check as of #1559)
#   2. Markdown Linting (formatting)
#   3. Unit Tests (if critical files changed)
#   4. PHPStan Static Analysis (if PHP files changed)
#   5. JavaScript Linting (if JS files changed and ESLint available)
#   6. Minify first-party JS/CSS (if source files changed and Node available)
#

set -e

echo "🔍 Running pre-commit quality checks..."

# Get list of staged files by type
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)
STAGED_MD_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.md$' | grep -v '^\.claude/agents/' | grep -v '^docs/releases/' || true)
STAGED_JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.js$' | grep -v '\.min\.js$' || true)

# Check if any critical files are modified (tests, core classes, etc.)
CRITICAL_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(php|json)$|phpunit\.xml' || true)

if [ -z "$STAGED_PHP_FILES" ] && [ -z "$STAGED_MD_FILES" ] && [ -z "$STAGED_JS_FILES" ] && [ -z "$CRITICAL_FILES" ]; then
    echo "✅ No relevant files staged, skipping quality checks"
    exit 0
fi

# Create temporary directory for staged files
TEMP_DIR=$(mktemp -d)
trap "rm -rf $TEMP_DIR" EXIT

echo "📁 Checking staged files only..."

# Copy staged versions of files to temp directory
ALL_STAGED_FILES="$STAGED_PHP_FILES $STAGED_MD_FILES"
for FILE in $ALL_STAGED_FILES; do
    if [ -n "$FILE" ]; then
        # Create directory structure in temp
        mkdir -p "$TEMP_DIR/$(dirname "$FILE")"
        # Get staged version of file
        git show ":$FILE" > "$TEMP_DIR/$FILE"
        echo "  • $FILE"
    fi
done

# Step 1: Run coding standards checker on staged PHP files. This also covers
# regression-test issue-linking traceability for tests/unit/regression/*.php
# (checkRegressionTestStructure() in check-coding-standards.php) — there is
# no separate step for that check; see #1559 for why it was folded in here
# instead of staying a second, independently-drifting bash implementation.
echo ""
echo "📋 Step 1: PHP Coding Standards"
if [ -n "$STAGED_PHP_FILES" ]; then
    if php scripts/check-coding-standards.php "$TEMP_DIR" --staged; then
        echo "✅ Passed"
    else
        echo ""
        echo "❌ COMMIT BLOCKED: Fix the issues above, stage fixes, and try again."
        echo "   Bypass (not recommended): git commit --no-verify"
        exit 1
    fi
else
    echo "⏭️  No PHP files staged"
fi

# Step 2: Run markdown linting on staged MD files
echo ""
echo "📝 Step 2: Markdown Lint"
if [ -n "$STAGED_MD_FILES" ]; then
    # Create list of staged markdown files for linting
    MD_FILES_LIST=""
    for FILE in $STAGED_MD_FILES; do
        if [ -n "$FILE" ]; then
            MD_FILES_LIST="$MD_FILES_LIST $TEMP_DIR/$FILE"
        fi
    done

    if npx markdownlint-cli2 $MD_FILES_LIST 2>/dev/null; then
        echo "✅ Passed"
    else
        echo ""
        echo "❌ COMMIT BLOCKED: Fix markdown issues above, stage fixes, and try again."
        echo "   Rules: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md"
        exit 1
    fi
else
    echo "⏭️  No markdown files staged"
fi

# Step 3: Run fast unit tests (if critical files changed)
echo ""
echo "🧪 Step 3: Unit Tests"
if [ -n "$CRITICAL_FILES" ]; then
    if [ ! -f "composer.json" ] || [ ! -d "vendor" ]; then
        echo "⚠️  Skipping: composer dependencies not installed"
    else
        if vendor/bin/phpunit --testsuite=Unit --exclude-group known-broken 2>&1; then
            echo "✅ Passed"
        else
            echo ""
            echo "❌ COMMIT BLOCKED: Fix failing tests. Run 'composer test:quick' to verify."
            exit 1
        fi
    fi
else
    echo "⏭️  No critical files changed"
fi

# Step 4: Run PHPStan static analysis (if PHP files changed)
echo ""
echo "🔬 Step 4: PHPStan Static Analysis"
if [ -n "$STAGED_PHP_FILES" ]; then
    if [ -f "vendor/bin/phpstan" ]; then
        if vendor/bin/phpstan analyse --no-progress --memory-limit=512M 2>&1; then
            echo "✅ Passed"
        else
            echo ""
            echo "❌ COMMIT BLOCKED: Fix PHPStan errors above."
            echo "   Bypass (not recommended): git commit --no-verify"
            exit 1
        fi
    else
        echo "⚠️  Skipping: phpstan not installed (composer require --dev phpstan/phpstan)"
    fi
else
    echo "⏭️  No PHP files staged"
fi

# Step 5: Run ESLint on staged JS files (if available)
echo ""
echo "📜 Step 5: JavaScript Lint"
if [ -n "$STAGED_JS_FILES" ]; then
    # Check if eslint is available
    if [ -f "node_modules/.bin/eslint" ] || command -v eslint &> /dev/null; then
        # Create list of staged JS files
        JS_FILES_LIST=""
        for FILE in $STAGED_JS_FILES; do
            if [ -n "$FILE" ]; then
                JS_FILES_LIST="$JS_FILES_LIST $FILE"
            fi
        done

        if npx eslint $JS_FILES_LIST 2>/dev/null; then
            echo "✅ Passed"
        else
            echo ""
            echo "❌ COMMIT BLOCKED: Fix ESLint errors above."
            echo "   Bypass (not recommended): git commit --no-verify"
            exit 1
        fi
    else
        echo "⏭️  ESLint not installed (optional: npm install)"
    fi
else
    echo "⏭️  No JavaScript files staged"
fi

# Step 6: Minify first-party JS/CSS if source files changed
STAGED_FIRST_PARTY=$(git diff --cached --name-only --diff-filter=ACMR | \
  grep -E '^app/assets/(js|css)/[^/]+\.(js|css)$|^app/admin/assets/[^/]+\.(js|css)$' | \
  grep -v '\.min\.' || true)

if [ -n "$STAGED_FIRST_PARTY" ]; then
    echo ""
    echo "📦 Step 6: Minify first-party JS/CSS"
    if ! command -v node >/dev/null 2>&1; then
        echo "⚠️  WARNING: Node not found — skipping minification. Commit may include stale .min.* files."
        echo "   Install Node and run 'npm run build' before pushing."
    elif node scripts/build.js; then
        git add app/assets/js/*.min.js app/assets/css/*.min.css \
                app/admin/assets/*.min.js app/admin/assets/*.min.css 2>/dev/null || true
        echo "✅ Passed"
    else
        echo ""
        echo "❌ COMMIT BLOCKED: Build failed. Run 'npm run build' to debug."
        exit 1
    fi
fi

# All checks passed
echo ""
echo "🎉 All pre-commit checks passed!"
exit 0