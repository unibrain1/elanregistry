#!/bin/bash

#
# Pre-push hook:
#   1. BLOCKING integration-test gate (#1439) — see below.
#   2. Non-blocking reminder to run /review-pr before pushing a feature branch.
#
# Rationale for the reminder: CI runs a lightweight Sonnet-backed review on
# PRs targeting milestone branches and relies on the author having done a
# deep multi-agent review locally. Running /review-pr on your Claude Max/Pro
# subscription catches issues before CI cycles burn tokens on every push.
#
# The reminder section NEVER blocks a push. It only prints on the first push
# of a branch that looks like feature / issue work (issue/*, claude/*,
# feat/*, fix/*, chore/*, refactor/*) when the remote branch does not yet
# exist. Set SKIP_REVIEW_PR_REMINDER=1 to silence it.
#
# The integration-gate section DOES block a push — see its comment block
# below for scope, the remote restriction, and the --no-verify escape hatch.
#

# Read ref updates from stdin ONCE, into a variable. git pipes the ref list
# to pre-push hooks as a one-shot stream — a shell pipe cannot be rewound
# once read, so with two sections each needing the full ref list (the gate
# below, and the reminder that already existed), the list has to be captured
# up front and each section loops over the saved copy instead of stdin
# directly.
ref_updates="$(cat)"

# git passes the pushed-to remote's name as $1 (its URL as $2) — separate
# from the per-ref stdin data above.
remote_name="${1:-}"

# =============================================================================
# 1. Integration-test gate (#1439)
#
# Restricted to the `origin` remote (GitHub) only. This repo also has `prod`
# and `test` deploy remotes (see Registry/CLAUDE.md) — `git push prod main` /
# `git push test main` deploy already-CI-verified, already-merged `main`
# code, not new work. Running a ~2 min blocking suite (and hard-failing the
# whole push if the *local* test schema happens to be unreachable at that
# exact moment — see #1591) on a deploy would tie deploy success to local
# dev-machine state that has nothing to do with the code being deployed.
#
# Only runs when the push touches files matching
# ^(app|usersc/classes|tests/integration)/.*\.php$ — those are the paths the
# integration suite actually exercises. Pushes that touch none of them skip
# this section entirely (fast path).
#
# Runs the FULL integration suite (composer test:integration, ~2 min locally)
# against the dedicated test schema configured in .env.test.local.
# tests/bootstrap-integration.php already fails loudly (exit 1) if that
# database is unreachable or misconfigured (#1591) — this hook does not
# duplicate that preflight check, it just blocks the push on ANY non-zero
# exit code from composer test:integration, whether that's an unreachable DB
# or an actual test failure. Both are "block the push" per the issue's
# acceptance criteria.
#
# Escape hatch: `git push --no-verify` skips this hook entirely (standard git
# behavior — no extra code needed here).
# =============================================================================

integration_gate_paths='^(app|usersc/classes|tests/integration)/.*\.php$'
gate_failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip deletes
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Restricted to origin — see the comment block above this loop.
    if [ "$remote_name" != "origin" ]; then
        continue
    fi

    branch="${local_ref#refs/heads/}"

    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
        # Updating an existing remote ref — diff against its current tip.
        base="$remote_sha"
    else
        # New ref (first push of this branch, e.g. right after /start-issue's
        # `git checkout -b` + `git push -u`). At the moment this hook runs,
        # the branch may not have an upstream configured yet — the tracking
        # lookup below fails to resolve in that case. Falling back to diffing
        # local_sha against itself (empty diff) would silently skip the gate
        # on exactly the case this issue (#1439) exists to cover: the first
        # push of new feature work. Fall back through:
        #   1. the pushed branch's own configured upstream, if any. Uses
        #      "$branch@{upstream}" — the *named* branch being pushed, not
        #      bare '@{u}', which resolves against whatever's currently
        #      checked out and would silently compute the wrong base for an
        #      explicit `git push origin some-other-branch:some-other-branch`
        #      run from a different branch.
        #   2. origin/main (this repo's default branch — issue branches
        #      always trace back to it through their milestone branch, so
        #      the merge-base reliably isolates just this branch's commits)
        #   3. local_sha itself, only if both above fail to resolve (e.g. no
        #      'origin' remote at all) — printed loudly so it's never a
        #      silent gap.
        if base="$(git merge-base "$local_sha" "${branch}@{upstream}" 2>/dev/null)"; then
            :
        elif base="$(git merge-base "$local_sha" origin/main 2>/dev/null)"; then
            :
        else
            echo "  WARNING: could not resolve a merge-base for '$local_ref' (no upstream, no origin/main)." >&2
            echo "  Integration gate cannot determine changed files and will be SKIPPED for this ref." >&2
            base="$local_sha"
        fi
    fi

    changed_files="$(git diff --name-only "$base" "$local_sha")"

    if ! printf '%s\n' "$changed_files" | grep -qE "$integration_gate_paths"; then
        continue
    fi

    cat <<EOF

  Integration-test gate: push to '$branch' touches app/, usersc/classes/, or
  tests/integration/. Running the full integration suite before allowing this
  push (composer test:integration, ~2 min against the test schema)...

EOF

    if ! composer test:integration; then
        cat <<EOF

  BLOCKED: integration suite failed (or the test database was unreachable —
  check the output above). Push aborted.

  Fix the failure, or bypass with: git push --no-verify

EOF
        gate_failed=1
    fi
done <<< "$ref_updates"

if [ "$gate_failed" -eq 1 ]; then
    exit 1
fi

# =============================================================================
# 2. Non-blocking /review-pr reminder (pre-existing behavior, unchanged)
# =============================================================================

if [ -n "${SKIP_REVIEW_PR_REMINDER:-}" ]; then
    exit 0
fi

reminder_shown=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip deletes
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    branch="${local_ref#refs/heads/}"

    # Only remind on branches that look like feature / issue work
    case "$branch" in
        issue/*|claude/*|feat/*|fix/*|chore/*|refactor/*)
            ;;
        *)
            continue
            ;;
    esac

    # Only remind on the first push (remote ref is all-zeros).
    # Use a flag instead of break so all refs are evaluated — on a
    # multi-branch push a later ref may be the new one that needs the reminder.
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ] && [ "$reminder_shown" -eq 0 ]; then
        cat <<EOF

  Heads up: first push of branch '$branch'.

  Consider running /review-pr locally before pushing. The CI on this PR is
  a lightweight backstop that assumes a deep multi-agent review already
  happened on your machine.

  See docs/development/CODING_STANDARDS.md and CLAUDE.md for the workflow.

  (Silence this reminder with SKIP_REVIEW_PR_REMINDER=1 git push ...)

EOF
        reminder_shown=1
    fi
done <<< "$ref_updates"

exit 0
